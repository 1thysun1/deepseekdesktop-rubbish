{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Desktop",
  "version": "0.1.0",
  "identifier": "local.deepseek.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeepSeek 桌面端",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#111111"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.deepseek.com https://chat.deepseek.com https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
